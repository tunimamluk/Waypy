{
	"schemaVersion": 1,
	"id": "waypy",
	"version": "${version}",
	"name": "Waypy",
	"description": "Client-side waypoints: mark blocks or whole areas with beacon beams or highlights and coloured pins, group them, and reuse looks and layouts with presets.",
	"authors": ["tunimamluk"],
	"contact": {
		"sources": "https://github.com/tunimamluk/Waypy",
		"issues": "https://github.com/tunimamluk/Waypy/issues"
	},
	"license": "MIT",
	"icon": "assets/waypy/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.waypy.WaypyClient"]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
